---
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../data/site';
import { ORG_ID, SITE_ID } from '../lib/jsonld';
interface Props { title: string; description: string; kicker?: string; lede?: string; updated?: string; citations?: string[] }
const { title, description, kicker, lede, updated = SITE.launchDate, citations = [] } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.url).href;
const graph = [
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    name: title,
    description,
    url,
    datePublished: SITE.launchDate,
    dateModified: updated,
    inLanguage: 'en-GB',
    isPartOf: { '@id': SITE_ID },
    publisher: { '@id': ORG_ID },
    ...(citations.length ? { citation: citations } : {}),
  },
];
---
<Base title={title} description={description} crumbs={[{ name: title, href: Astro.url.pathname }]} graph={graph}>
  <div class="wrap page">
    <PageHeader title={title} kicker={kicker} lede={lede} updated={updated} />
    <div class="prose">
      <slot />
      <h2>Contact</h2>
      <p>Publisher: <a href="https://tourground.com">Tourground</a>. Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. Our postal address is being confirmed; until it is published here, please write to us by email.</p>
    </div>
  </div>
</Base>
