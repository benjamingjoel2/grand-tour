---
import { formatDate, type Post } from '../lib/posts';
interface Props { sources: Post['data']['sources']; updated: Date }
const { sources, updated } = Astro.props;
---
{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-h">
    <h2 id="sources-h">Sources</h2>
    <p class="meta">Practical details checked against these sources on {formatDate(updated)}. Rules, timetables and opening dates change: check them before you book.</p>
    <ol>
      {sources.map((s) => (
        <li>
          <a href={s.url} rel="nofollow noopener">{s.title}</a>
          {s.publisher && <span>, {s.publisher}</span>}
          <span class="host"> ({new URL(s.url).hostname.replace(/^www\./, '')}{s.retrieved ? `, retrieved ${formatDate(s.retrieved)}` : ''})</span>
        </li>
      ))}
    </ol>
  </section>
)}
<style>
  .sources { border-top: 1px solid var(--line); padding-top: 1.5rem; margin-top: 2rem; font-size: 0.93rem; }
  h2 { font-size: 1.3rem; }
  ol { padding-left: 1.25rem; }
  li { margin-bottom: 0.45rem; overflow-wrap: anywhere; }
  .host { color: var(--muted); }
</style>
